# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/asson_ecommerce
# or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/asson_ecommerce?retryWrites=true&w=majority

# Cloudinary Configuration
# Provide the single CLOUDINARY_URL (copied directly from your Cloudinary Dashboard under API Keys)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Staff Admin Portal Credentials (Operational views: Orders, Inquiries, Studio Designs, Blank Uploads)
ADMIN_EMAIL=admin@assonclothing.com
ADMIN_PASSWORD=change_this_to_a_secure_password

# Superadmin Portal Credentials (Full maintenance: Developer Console, Database Seeder, JSON Backups)
SUPERADMIN_EMAIL=superadmin@assonclothing.com
SUPERADMIN_PASSWORD=change_this_to_superadmin_password

# App settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
